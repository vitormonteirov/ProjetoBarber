# ==========================================================================
# Exemplo de Variáveis de Ambiente para Produção (.env)
# Copie para .env e substitua pelos segredos reais (NUNCA faça commit do .env)
# ==========================================================================
SPRING_PROFILES_ACTIVE=prod
H2_CONSOLE_ENABLED=false

# Banco de Dados PostgreSQL (Docker Compose ou Cloud RDS/Supabase/Neon)
DATABASE_URL=jdbc:postgresql://localhost:5432/barber_db
POSTGRES_DB=barber_db
DB_USERNAME=barber_user
DB_PASSWORD=SubstituaPorUmaSenhaForteDeProducao!2026

# Segurança JWT (Mínimo 256 bits / 32+ caracteres aleatórios em Base64)
JWT_SECRET=GereUmaChaveAleatoriaDe384BitsComOpenSSLBase64Aqui==
JWT_ISSUER=ProjetoBarber-API
JWT_EXPIRATION_HOURS=8

# Conta Prévia do Gestor
GESTOR_NOME=Gestor Tenorio
GESTOR_EMAIL=gestor@tenoriosbarber.com
GESTOR_SENHA=SubstituaPelaSenhaForteDoGestor!2026

# Proteção Rate Limiting (Requisições por minuto por IP)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=15
RATE_LIMIT_API_PER_MINUTE=120

# Origens CORS Permitidas (Separadas por vírgula)
CORS_ALLOWED_ORIGINS=https://tenoriosbarber.com.br,http://localhost,http://localhost:5500
